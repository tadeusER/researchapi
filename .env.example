# ======================
# Application Settings
# ======================
APP_NAME=ResearchAPI
APP_VERSION=2.0.0
APP_ENVIRONMENT=development  # development, staging, production
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ======================
# API Keys
# ======================
# Springer Nature API Key
# Get it from: https://dev.springernature.com/
SPRINGER_API_KEY=your_springer_api_key_here

# IEEE Xplore API Key
# Get it from: https://developer.ieee.org/
IEEE_API_KEY=your_ieee_api_key_here

# Note: arXiv and Cambridge APIs don't require keys

# ======================
# Database & Cache
# ======================
# Redis Configuration (optional, for caching)
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Cache TTL (Time To Live) in seconds
CACHE_TTL=3600  # 1 hour
CACHE_MAX_SIZE=1000  # Max number of cached items

# ======================
# Rate Limiting
# ======================
# Global rate limiting
GLOBAL_RATE_LIMIT_ENABLED=true
GLOBAL_RATE_LIMIT_REQUESTS=100
GLOBAL_RATE_LIMIT_PERIOD=60  # seconds

# Per-source rate limiting (requests per minute)
ARXIV_RATE_LIMIT=20
ARXIV_RATE_PERIOD=60
ARXIV_DELAY=3  # Delay between requests in seconds

CAMBRIDGE_RATE_LIMIT=30
CAMBRIDGE_RATE_PERIOD=60
CAMBRIDGE_DELAY=2

IEEE_RATE_LIMIT=30
IEEE_RATE_PERIOD=60
IEEE_DELAY=2

SPRINGER_RATE_LIMIT=30
SPRINGER_RATE_PERIOD=60
SPRINGER_DELAY=2

# ======================
# HTTP Client Settings
# ======================
HTTP_TIMEOUT=30  # seconds
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY=1  # seconds
HTTP_RETRY_BACKOFF=2  # exponential backoff multiplier
HTTP_CONNECTION_POOL_SIZE=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# ======================
# Logging
# ======================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/researchapi.log
LOG_FILE_MAX_SIZE=10485760  # 10MB
LOG_FILE_BACKUP_COUNT=5

# ======================
# API Features
# ======================
# Enable/disable specific sources
ARXIV_ENABLED=true
CAMBRIDGE_ENABLED=true
IEEE_ENABLED=true
SPRINGER_ENABLED=true

# Default search parameters
DEFAULT_MAX_RESULTS=10
DEFAULT_SORT_BY=relevance  # relevance, date, citations
DEFAULT_SORT_ORDER=desc  # asc, desc

# ======================
# Security
# ======================
# CORS
CORS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# API Authentication (if needed)
API_KEY_ENABLED=false
API_KEY_HEADER=X-API-Key
API_KEYS=[]  # List of valid API keys

# ======================
# GraphQL
# ======================
GRAPHQL_ENABLED=true
GRAPHQL_PLAYGROUND_ENABLED=true
GRAPHQL_INTROSPECTION_ENABLED=true

# ======================
# Monitoring & Health
# ======================
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
SENTRY_DSN=  # Optional: Sentry error tracking

# ======================
# Testing
# ======================
TESTING=false
TEST_DATABASE_URL=sqlite:///./test.db

# ======================
# Docker Specific
# ======================
# These are used in docker-compose.yml
COMPOSE_PROJECT_NAME=researchapi
DOCKER_NETWORK=researchapi_network
